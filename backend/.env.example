# Copy to backend/.env and fill in. This file is the only place the key lives.
# backend/.env is gitignored; never commit it, never paste the key into a chat,
# never put it in the app or in Gradle.

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Stable and image-capable. Others: gemini-3.5-flash-lite (cheaper),
# gemini-3.8-flash (newest stable).
GEMINI_MODEL=gemini-3.5-flash

# Any long random string. The phone must send the same value.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DOT_CLIENT_TOKEN=generate-me

# Optional
DOT_TIMEOUT_S=20
DOT_MAX_ATTEMPTS=2
DOT_RATE_PER_MIN=30
DOT_RATE_BURST=8
# Structural tracing only: counts and decision kinds, never content.
DOT_VERBOSE=0

# ---- Dot Plus (RevenueCat) -------------------------------------------------
# RevenueCat SECRET API key (starts "sk_"). Server only: it verifies who has
# Dot Plus. Never put it in the app, in Gradle, or in local.properties.
# Without it, nobody is ever treated as having Plus.
REVENUECAT_SECRET_KEY=
# The entitlement Dot Plus unlocks.
REVENUECAT_ENTITLEMENT=dot_plus

# ---- Usage ledger ----------------------------------------------------------
# Where identities and guided tasks are recorded (SQLite). Default: backend/data/dot.sqlite3
# DOT_DB_PATH=
# Planning requests must come from a registered install with an admitted task.
# Leave on; "0" is only for the old contract tests.
DOT_REQUIRE_IDENTITY=1
